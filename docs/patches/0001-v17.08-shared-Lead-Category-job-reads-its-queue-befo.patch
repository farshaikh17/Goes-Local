+// ================= follow-up A: Lead Category job skips the GHL field lookup when nothing is queued =================
+{
+  console.log("\n== Follow-up A: leadCatBatch");
+  const s = await site({ CITY_SYNC_COOLDOWN_MIN: "60" });
+  await s.tick(); await s.tick();                                     // first full pass, then every tick below skips the sync
+  const quiet = async () => { await s.setMeta("cron_hourly_at", Date.now()); const f = s.g.calls.customFields, p = s.g.calls.put.length; const l = await s.tick(); return { fields: s.g.calls.customFields - f, puts: s.g.calls.put.slice(p), l }; };
+  const q = n => s.count("SELECT COUNT(*) n FROM lead_cat_fix");
+  const add = (...ids) => Promise.all(ids.map((id, i) => s.DB.prepare("INSERT INTO lead_cat_fix(ghl_id,cat,created_at) VALUES(?1,'Plumbing',?2)").bind(id, i + 1).run()));
+  await s.DB.prepare("DELETE FROM lead_cat_fix").run();
+  let r = await quiet();
+  check("empty queue: no GHL custom-field lookup on the tick", r.fields === 0, `lookups=${r.fields}`);
+  check("empty queue: no GHL writes, no log line", r.puts.length === 0 && !r.l.some(x => /Lead Category/.test(x)));
+  await add("qa0001", "qa0002", "qa0003");
+  r = await quiet();
+  check("pending: one field lookup, 3 Lead Category writes (custom field only)", r.fields === 1 && r.puts.length === 3 && r.puts.every(p => JSON.stringify(Object.keys(p.body)) === '["customFields"]' && p.body.customFields[0].id === "f_lead"), `lookups=${r.fields} puts=${r.puts.length}`);
+  check("pending: written rows are removed from the queue", (await q()) === 0);
+  check("pending: log line unchanged", r.l.some(x => /cron: Lead Category written for 3 contacts, 0 left/.test(x)));
+  await add("qa0004", "qa0005");
+  await s.setMeta("leadcat_pause", "1");
+  r = await quiet();
+  check("paused: no lookup, no writes, queue kept", r.fields === 0 && r.puts.length === 0 && (await q()) === 2);
+  await s.setMeta("leadcat_pause", "0");
+  s.g.put429 = true;
+  r = await quiet();
+  check("rate-limited (429): stops after the first write, nothing removed", r.puts.length === 1 && (await q()) === 2, `puts=${r.puts.length} left=${await q()}`);
+  s.g.put429 = false;
+  r = await quiet();
+  check("…retried next tick: both written and removed", r.puts.length === 2 && (await q()) === 0);
+  await add("qa0006");
+  s.g.noLeadField = true;
+  r = await quiet();
+  check("missing Lead Category field with a row queued: same error, row kept", r.l.some(x => /no Lead Category field/.test(x)) && (await q()) === 1 && r.puts.length === 0);
+  s.g.noLeadField = false;
+  await s.DB.prepare("UPDATE lead_cat_fix SET cat='Roofing' WHERE ghl_id='qa0006'").run();
+  await s.mf.dispose();
+}
+
 console.log(failures ? `\n${failures} check(s) FAILED` : "\nall checks passed");
 process.exit(failures ? 1 : 0);
